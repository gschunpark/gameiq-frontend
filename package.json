{
  "name": "game-iq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "concurrently -k -n client,server \"npm run dev:client\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "dev:client": "vite",
    "dev:server": "node --watch backend/index.js",
    "start:server": "node backend/index.js",
    "test:smoke": "node --env-file=.env backend/smoke.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "zod": "^4.6.7"
  }
}
